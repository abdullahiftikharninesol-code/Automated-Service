# API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/missed_lead_rescue
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
FOLLOWUP_NEW_LEAD_MINUTES=30
FOLLOWUP_SECOND_REMINDER_HOURS=2
FOLLOWUP_CONTACTED_HOURS=24
FOLLOWUP_FINAL_DAYS=3

# Rate Limiting & Hardening
RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REGISTER_RATE_LIMIT=5/minute
PUBLIC_INBOUND_RATE_LIMIT=30/minute

# Webhook Security
WEBHOOK_SIGNATURE_REQUIRED=false

# Email Provider Settings
EMAIL_TIMEOUT_SECONDS=5.0

# Background Jobs & Reminder Engine (Phase 2.5C)
BACKGROUND_JOBS_ENABLED=true
REMINDER_SWEEP_INTERVAL_SECONDS=60
DEFAULT_OWNER_REMINDER_DELAY_MINUTES=60
DEFAULT_OWNER_REMINDER_REPEAT_MINUTES=60
DEFAULT_OWNER_REMINDER_MAX_ATTEMPTS=3
JOB_MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=300
JOB_PROCESSING_TIMEOUT_MINUTES=10

# Web (copy the relevant line to apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
